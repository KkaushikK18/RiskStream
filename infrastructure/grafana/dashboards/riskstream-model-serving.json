        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left"
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "show": true
        }
      }
