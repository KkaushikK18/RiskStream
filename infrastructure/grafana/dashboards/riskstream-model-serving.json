    {
      "id": 10,
      "type": "heatmap",
      "title": "Fraud probability distribution",
      "description": "Calibrated probabilities of scored transactions (histogram buckets).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
