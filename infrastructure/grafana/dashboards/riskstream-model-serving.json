      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(riskstream_decisions_total{decision=\"DECLINE\"}[$__rate_interval])) / clamp_min(sum(rate(riskstream_decisions_total[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
