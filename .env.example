# RiskStream Environment Configuration

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data paths
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
