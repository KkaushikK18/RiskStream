# RiskStream environment settings. Copy to .env and fill in. Never commit .env.
# Versioned pipeline and service settings live in configs/*.yaml.

ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text | json  (json for containers / log shipping)
LOG_FORMAT=text
RANDOM_SEED=42

# Optional override. Default: sqlite database mlflow.db in the project root.
# MLFLOW_TRACKING_URI=sqlite:///C:/path/to/RiskStream/mlflow.db

# ---------------------------------------------------------------- PostgreSQL
# Used by docker-compose.yml (pick long random values).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
RISKSTREAM_OWNER_PASSWORD=change-me-owner
RISKSTREAM_APP_PASSWORD=change-me-app

# API connection: DML-only role.
DATABASE_URL=postgresql+psycopg://riskstream_app:change-me-app@127.0.0.1:5433/riskstream
# Migrations and backfill: owner role.
MIGRATION_DATABASE_URL=postgresql+psycopg://riskstream_owner:change-me-owner@127.0.0.1:5433/riskstream
# Disposable database for tests/integration (tables are dropped and recreated).
# RISKSTREAM_TEST_DATABASE_URL=postgresql+psycopg://riskstream_owner:change-me-owner@127.0.0.1:5433/riskstream_test

# ---------------------------------------------------------------- Serving
# Explicit model and policy versions (no "latest" lookup).
MODEL_BUNDLE_PATH=models/candidates/<model_version>
POLICY_PATH=models/policies/<model_version>/<policy-file>.json

# JSON list of clients. Generate entries with:
#   python -m riskstream.cli create-api-key --name demo --roles scorer,reader,labeler
API_KEYS=[]

# Optional: identifies this replica in logs, metrics and the predictions table.
# INSTANCE_ID=api-1
