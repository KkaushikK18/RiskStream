# RiskStream environment settings. Copy to .env and adjust.
# Pipeline settings (paths, split boundaries, features, models) live in configs/*.yaml.

ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

RANDOM_SEED=42

# Optional override. Default: sqlite database mlflow.db in the project root.
# MLFLOW_TRACKING_URI=sqlite:///C:/path/to/RiskStream/mlflow.db
